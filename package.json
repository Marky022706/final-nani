{
  "name": "final-nani",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,green \"npm run dev:frontend\" \"npm run api\"",
    "dev:frontend": "vite",
    "dev:all": "npm run dev",
    "api": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "test:backend": "cd backend && php artisan test",
    "test:integration": "node scripts/test-login-flow.mjs && node scripts/test-bulk-upload.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.38.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
